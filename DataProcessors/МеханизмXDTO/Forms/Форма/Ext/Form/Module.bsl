// БЕЗ ИЗМЕНЕНИЯ КОНФИГУРАЦИИ

&НаКлиенте
Процедура БезИзмененияКонфигурации_СписокТоваров_Выгрузить()
	
	// Для работы с XDTO-типами из КОНФИГУРАЦИИ используем стандартный объект "ФабрикаXDTO".
	// Для работы с XDTO-типами из ВНЕШНЕЙ XSD-СХЕМЫ нужно сначала создать свою фабрику!
	
	// Создаём фабрику на основе внешней xsd-схемы:
	ПолноеИмяФайлаСхемы = ТекущийКаталог + "Прайс-лист (xml-схема).xsd";
	МояФабрикаXDTO = СоздатьФабрикуXDTO(ПолноеИмяФайлаСхемы);
	
	// Дальше всё как обычно, только через "МояФабрикаXDTO":
	
	// Создание файла
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ТекущийКаталог + "Список товаров (без изменения конфигурации).xml");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	// Типы данных для выгрузки
	ОписаниеТипаТовар = 
	МояФабрикаXDTO.Тип("http://infostart.ru/price", "Товар");
	
	ОписаниеТипаПрайсЛист = 
	МояФабрикаXDTO.Тип("http://infostart.ru/price", "ПрайсЛист");

	// Корневой элемент
	ПрайсЛистXDTO = МояФабрикаXDTO.Создать(ОписаниеТипаПрайсЛист);
	
	ПрайсЛистXDTO.Организация =
	ОбщегоНазначения_Сервер.ПолучитьЗначениеКонстанты("НаименованиеФирмы");
	
	ПрайсЛистXDTO.ДатаАктуальности = ТекущаяДата();
	
	// Товар #1
	ТоварXDTO = МояФабрикаXDTO.Создать(ОписаниеТипаТовар);
	
	ТоварXDTO.Код = 10;
	ТоварXDTO.Наименование = "Ванна чугунная";
	ТоварXDTO.Цена = 15000;
	
	ПрайсЛистXDTO.Товары.Добавить(ТоварXDTO);
	
	// Товар #2
	ТоварXDTO = МояФабрикаXDTO.Создать(ОписаниеТипаТовар);
	
	ТоварXDTO.Код = 11;
	ТоварXDTO.Наименование = "Клей для плитки";
	ТоварXDTO.Цена = 350;
	
	ПрайсЛистXDTO.Товары.Добавить(ТоварXDTO);
	
	// Запись в файл
	МояФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ПрайсЛистXDTO);
	
	ЗаписьXML.Закрыть();	
		
КонецПроцедуры

