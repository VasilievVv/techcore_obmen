&НаСервере
Процедура OLE_Выгрузка()
	
	БазаOLE = Новый COMОбъект("v83.Application"); // Толстяк
	
	БазаOLE.Connect(СтрокаСоединения);
	
	// Создаем группу в базе #2
	ГруппаВБазе2 = 
	БазаOLE.Справочники.Номенклатура.НайтиПоНаименованию("Номенклатура из базы #1", Истина);
	
	Если ГруппаВБазе2 = БазаOLE.Справочники.Номенклатура.ПустаяСсылка() Тогда
		
		ГруппаВБазе2 = БазаOLE.Справочники.Номенклатура.СоздатьГруппу();
		ГруппаВБазе2.УстановитьНовыйКод();
		ГруппаВБазе2.Наименование = "Номенклатура из базы #1";
		ГруппаВБазе2.Записать();
		
	КонецЕсли;	
	
	// Выгружаем товары из группы "Для ванной"
	ГруппаДляВанной =
	Справочники.Номенклатура.НайтиПоНаименованию("Для ванной", Истина);
	
	Выборка = 
	Справочники.Номенклатура.Выбрать(ГруппаДляВанной);
	
	Пока Выборка.Следующий() Цикл
		
		КодТовараВБазе2 = "#1-" + Выборка.Код;
		
		ТоварВБазе2 = 
		БазаOLE.Справочники.Номенклатура.НайтиПоКоду(КодТовараВБазе2);
		
		Если ТоварВБазе2 =
			БазаOLE.Справочники.Номенклатура.ПустаяСсылка() Тогда
			
			ТоварВБазе2 = 
			БазаOLE.Справочники.Номенклатура.СоздатьЭлемент();
			
			ТоварВБазе2.Родитель = ГруппаВБазе2.Ссылка;
			ТоварВБазе2.Код = КодТовараВБазе2;
			ТоварВБазе2.Наименование = Выборка.Наименование;
			ТоварВБазе2.ОсновнаяЕдиницаИзмерения =
			БазаOLE.Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Выборка.Единица.Наименование);
			
			ТоварВБазе2.Записать();
			
		КонецЕсли;	
		
	КонецЦикла;
	
	БазаOLE.ЗавершитьРаботуСистемы();
	
	Сообщения.ДобавитьСтроку("Выгрузка элементов из группы ""Для ванной"" успешно завершена!");	
	
КонецПроцедуры

&НаСервере
Процедура OLE_ИнтерактивныеОперации()
	
	БазаOLE = Новый COMОбъект("v83.Application"); // Толстяк
	БазаOLE.Connect(СтрокаСоединения);
	
	// Открываем форму отчета Прайс-лист в базе #2
	ПараметрыФормы = БазаOLE.NewObject("Структура");
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	
	ФормаОтчетаВБазе2 = БазаOLE.ОткрытьФорму("Отчет.ПрайсЛист.Форма", ПараметрыФормы);
	
	// Сохраняем результат отчета
	ПолноеИмяФайла = ТекущийКаталог + "Прайс-лист из базы #2.htm";
	ФормаОтчетаВБазе2.Результат.Записать(ПолноеИмяФайла, БазаOLE.ТипФайлаТабличногоДокумента.HTML);
	
	БазаOLE.ЗавершитьРаботуСистемы();
	
	Сообщения.ДобавитьСтроку("Прайс-лист (из базы #2) успешно сформирован и сохранен!
	|" + ПолноеИмяФайла);	
	
КонецПроцедуры


