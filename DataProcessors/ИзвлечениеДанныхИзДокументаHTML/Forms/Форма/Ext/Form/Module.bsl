#Область ПРОЧЕЕ

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекущийКаталог = 
	ОбщегоНазначения_Сервер.ПолучитьЗначениеКонстанты("ОсновнойКаталог") + "Вебинар 2\Обмен через html-документы\";
	
КонецПроцедуры

&НаКлиенте
Процедура АдресДокументаHTMLНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = 
	Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбора.Фильтр = "HTML-документ (*.htm;*.html)|*.htm;*.html";
	
	Если ПустаяСтрока(АдресДокументаHTML) Тогда
		ДиалогВыбора.Каталог = ТекущийКаталог; // Каталог по умолчанию
	КонецЕсли;
	
	Если ДиалогВыбора.Выбрать() Тогда
		АдресДокументаHTML = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрДокумента(Команда)
	
	ДокументHTML = АдресДокументаHTML;
	
КонецПроцедуры

#КонецОбласти
