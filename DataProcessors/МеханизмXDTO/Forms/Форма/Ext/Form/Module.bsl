&НаКлиенте
Процедура ВывестиТекстXMLФайлаВОкноСообщений(ПолноеИмяФайла)
	
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.Прочитать(ПолноеИмяФайла, "UTF-8");
	
	Сообщения.ДобавитьСтроку("ТЕКСТ ИЗ ФАЙЛА """ + ПолноеИмяФайла + """:
							 |--------------------------------------------------------------------------------
							 |
							 |" + ТекстДок.ПолучитьТекст());
	
КонецПроцедуры

